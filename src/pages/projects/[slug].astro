---
import { Picture } from 'astro:assets';
import Base from '../../layouts/Base.astro';
import ProjectActions from '../../components/ProjectActions.astro';
import { getProjects, projectDates } from '../../projects';

export async function getStaticPaths() {
  return (await getProjects()).map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { data } = project;
const lead = data.media[0]!;

// Lists of facts. A section with no facts is left out.
const lists = [
  { id: 'how-to', heading: data.playHeading, items: data.play, steps: data.playSteps },
  { id: 'built', heading: data.solo ? 'How I built it' : 'How we built it', items: data.built, steps: false },
  { id: 'team', heading: 'The team', items: data.members, steps: false },
].filter((s) => s.items.length > 0);
---

<Base
  title={data.title}
  description={data.summary}
  hero={{ title: data.title, plain: true }}
>
  <article class="page project wrap">
    <div class:list={['project-lead', { pixel: lead.pixel }]}>
      <Picture
        src={lead.src}
        alt={lead.alt}
        formats={['avif']}
        fallbackFormat="webp"
        widths={[480, 800, 1200].filter((w) => w <= lead.src.width)}
        sizes="(min-width: 40rem) 36rem, 100vw"
        loading="eager"
        fetchpriority="high"
      />
    </div>

    <header class="project-head">
      <p class="lead">{data.summary}</p>
      <p class="project-dates">{projectDates(data)}</p>
      <ProjectActions project={project} details={false} />
    </header>

    <div class="project-body">
      {
        data.about.length > 0 && (
          <>
            <h2 id="description">Description</h2>
            {data.about.map((paragraph) => (
              <p>{paragraph}</p>
            ))}
            {data.media.slice(1).map((more) => (
              <div class:list={['project-more', { pixel: more.pixel }]}>
                <Picture
                  src={more.src}
                  alt={more.alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[480, 800, 1200].filter((w) => w <= more.src.width)}
                  sizes="(min-width: 44rem) 41rem, 100vw"
                  loading="lazy"
                />
              </div>
            ))}
          </>
        )
      }
      {
        lists.map((s) => {
          const List = s.steps ? 'ol' : 'ul';
          return (
            <>
              <h2 id={s.id}>{s.heading}</h2>
              <List class="points">
                {s.items.map((item) => (
                  <li>{item}</li>
                ))}
              </List>
            </>
          );
        })
      }
    </div>
  </article>
</Base>

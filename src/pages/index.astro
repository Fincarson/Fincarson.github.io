---
import Base from '../layouts/Base.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { overview } from '../experience';
import { site } from '../site.config';
import { getProjects } from '../projects';

const featured = (await getProjects()).filter((p) => p.data.featured);
const [given, family] = site.name.split(' ');
---

<Base>
  <div class="hero" slot="sky">
    <h1 class="page-title"><span>{given}</span> <span>{family}</span></h1>
    <p class="page-sub">{site.headline}</p>
    <p class="motto">{site.motto}</p>
  </div>

  <div class="page wrap">
    <section class="section" aria-labelledby="about-me">
      <h2 id="about-me">About me</h2>
      {site.about.map((paragraph) => <p>{paragraph}</p>)}
    </section>

    <section class="section" aria-labelledby="work-with">
      <h2 id="work-with">What I work with</h2>
      <ul class="roles">
        {
          site.workWith.map((group) => (
            <li>
              <strong>{group.label}:</strong> {group.items}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <ul class="roles roles--notes">
        {
          overview.roles.map((role) => (
            <li>
              <p>
                <strong>{role.name}</strong>, {role.rest}
              </p>
              <p>{role.note}</p>
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="awards">
      <h2 id="awards">Awards</h2>
      <ul class="roles">
        {
          overview.awards.map((award) => (
            <li>
              <strong>{award.name}</strong>
              {award.rest}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="featured">
      <h2 id="featured">Featured projects</h2>
      <ul class="cards">
        {
          featured.map((project) => (
            <li>
              <ProjectCard project={project} level="h3" />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ul class="roles">
        {
          overview.schools.map((school) => (
            <li>
              <strong>{school.name}</strong>
              {school.rest}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

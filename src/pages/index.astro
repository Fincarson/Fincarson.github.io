---
import Base from '../layouts/Base.astro';
import Slideshow from '../components/Slideshow.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { currentRoles, schools } from '../experience';
import { site } from '../site.config';
import { getProjects } from '../projects';

const featured = (await getProjects()).filter((p) => p.data.featured);
const [given, family] = site.name.split(' ');
---

<Base>
  <div class="hero" slot="sky">
    <h1 class="page-title"><span>{given}</span> <span>{family}</span></h1>
    <p class="page-sub">{site.headline}</p>
    <p class="motto">{site.motto}</p>
  </div>

  <div class="page wrap">
    <Slideshow />

    <section class="section" aria-labelledby="about-me">
      <h2 id="about-me">About me</h2>
      <p>{site.about}</p>
    </section>

    <section class="section" aria-labelledby="experience">
      <h2 id="experience">Experience</h2>
      <ul class="roles">
        {
          currentRoles.map((role) => (
            <li>
              <strong>{role.title}</strong>, {role.org}, {role.dates}
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="featured">
      <h2 id="featured">Featured projects</h2>
      <ul class="cards">
        {
          featured.map((project) => (
            <li>
              <ProjectCard project={project} level="h3" />
            </li>
          ))
        }
      </ul>
    </section>

    <section class="section" aria-labelledby="education">
      <h2 id="education">Education</h2>
      <ul class="roles">
        {
          schools.map((school) => (
            <li>
              <strong>{school.name}</strong>, {school.rest}
            </li>
          ))
        }
      </ul>
    </section>
  </div>
</Base>

---
import Base from '../layouts/Base.astro';
import Button from '../components/Button.astro';
---

<Base notFound heavyTitle={false} title="Page not found" description="This page does not exist on fincarson.github.io.">
  <Fragment slot="sky">
    <h1 class="page-title page-title--long">Page not found</h1>
    <p class="page-sub">This page does not exist.</p>
  </Fragment>

  <div class="page wrap">
    <ul class="actions">
      <li><Button href="/">Go to Overview</Button></li>
      <li><Button href="/projects/">See all projects</Button></li>
    </ul>
  </div>
</Base>

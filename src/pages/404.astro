---
import Base from '../layouts/Base.astro';
import Tab from '../components/Tab.astro';
import NotFound from '../components/NotFound.astro';
import { NOT_FOUND } from '../site.config';
---

<Base notFound panels={[{ id: NOT_FOUND, title: 'Page not found' }]} description="This page does not exist on fincarson.github.io.">
  <Tab
    id={NOT_FOUND}
    description="This page does not exist on fincarson.github.io."
    kind="away"
    hero={{ title: 'Error 404', mark: ':(', subtitle: 'Page not found.', plain: true }}
  >
    <NotFound />
  </Tab>
</Base>

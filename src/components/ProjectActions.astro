---
// The buttons under a project. In a card: the video where one exists, GitHub, then
// its page, always last. On the project's own page: GitHub, then the video.
// Each aria-label starts with the visible text and names the project.
import type { CollectionEntry } from 'astro:content';
import Button from './Button.astro';

interface Props {
  project: CollectionEntry<'projects'>;
  /** False on the project's own page. */
  details?: boolean;
}

const { project, details = true } = Astro.props;
const { data } = project;
---

<ul class="actions">
  {
    details && data.video && (
      <li>
        <Button href={data.video.url} icon="youtube" label={`${data.video.label}: ${data.title} (YouTube)`}>
          {data.video.label}
        </Button>
      </li>
    )
  }
  <li>
    <Button href={data.repo} icon="github" label={`View on GitHub: ${data.title}`}>View on GitHub</Button>
  </li>
  {
    !details && data.video && (
      <li>
        <Button href={data.video.url} icon="youtube" label={`${data.video.label}: ${data.title} (YouTube)`}>
          {data.video.label}
        </Button>
      </li>
    )
  }
  {
    details && (
      <li>
        <Button href={`/projects/${data.slug}/`} label={`See details: ${data.title}`}>
          See details
        </Button>
      </li>
    )
  }
</ul>

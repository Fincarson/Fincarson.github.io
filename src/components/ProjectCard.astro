---
// One project, on Projects and Overview: picture, title, dates, one-line
// description, an award where there is one, then the buttons pinned to the
// bottom. Every picture has the same shape.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import ProjectActions from './ProjectActions.astro';
import { projectDates } from '../projects';

interface Props {
  project: CollectionEntry<'projects'>;
  /** True for the pictures above the fold. */
  eager?: boolean;
  /** The title's heading level: h3 where the cards sit under a section heading. */
  level?: 'h2' | 'h3';
}

const { project, eager = false, level: Title = 'h2' } = Astro.props;
const { data } = project;
const media = data.media[0]!;
---

<article class="card">
  <div class:list={['card-media', { pixel: media.pixel }]}>
    <Picture
      src={media.src}
      alt={media.alt}
      formats={['avif']}
      fallbackFormat="webp"
      widths={[480, 800, 1200].filter((w) => w <= media.src.width)}
      sizes="(min-width: 76rem) 36rem, (min-width: 48em) 47vw, 100vw"
      loading={eager ? 'eager' : 'lazy'}
      fetchpriority={eager ? 'high' : undefined}
    />
  </div>
  <div class="card-body">
    <Title class="card-title" set:html={data.title.replaceAll('_', '_<wbr>')} />
    <p class="card-dates">{projectDates(data)}</p>
    <p>{data.summary}</p>
    {data.award && <p class="card-award">{data.award}</p>}
    <ProjectActions project={project} />
  </div>
</article>

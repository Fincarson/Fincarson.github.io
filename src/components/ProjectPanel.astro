---
// One project's panel. The hero holds no text: the picture straddles its
// bottom edge and the title sits under it. Then lists of facts; a section
// with no facts is left out.
import { Picture } from 'astro:assets';
import type { CollectionEntry } from 'astro:content';
import Tab from './Tab.astro';
import ProjectActions from './ProjectActions.astro';
import { projectDates } from '../projects';
import { projectId } from '../site.config';

interface Props {
  project: CollectionEntry<'projects'>;
}

const { project } = Astro.props;
const { data } = project;
const lead = data.media[0]!;

const lists = [
  { id: 'how-to', heading: data.playHeading, items: data.play, steps: data.playSteps },
  { id: 'built', heading: data.solo ? 'How I built it' : 'How we built it', items: data.built, steps: false },
  { id: 'team', heading: 'The team', items: data.members, steps: false },
].filter((s) => s.items.length > 0);
---

<Tab id={projectId(data.slug)} description={data.summary}>
  <article class="page project wrap">
    <div class="project-top">
      <div class:list={['project-lead', { pixel: lead.pixel }]} style={`--ar: ${lead.src.width / lead.src.height}`}>
        <Picture
          src={lead.src}
          alt={lead.alt}
          formats={['avif']}
          fallbackFormat="webp"
          widths={[480, 800, 1280].filter((w) => w <= lead.src.width)}
          sizes="(min-width: 70rem) 64rem, 100vw"
          loading="lazy"
        />
      </div>

      <header class="project-head">
        <h1 class="project-title" tabindex="-1">{data.title}</h1>
        <p class="lead">{data.summary}</p>
        <p class="project-dates">{projectDates(data)}</p>
        <ProjectActions project={project} details={false} />
      </header>
    </div>

    {
      data.about.length > 0 && (
        <section class="section" aria-labelledby={`${data.slug}-description`}>
          <h2 id={`${data.slug}-description`}>Description</h2>
          {data.about.map((paragraph) => (
            <p>{paragraph}</p>
          ))}
          {data.media.slice(1).map((more) => (
            <div class:list={['project-more', { pixel: more.pixel }]}>
              <Picture
                src={more.src}
                alt={more.alt}
                formats={['avif']}
                fallbackFormat="webp"
                widths={[480, 800, 1200].filter((w) => w <= more.src.width)}
                sizes="(min-width: 44rem) 41rem, 100vw"
                loading="lazy"
              />
            </div>
          ))}
        </section>
      )
    }
    {
      lists.map((s) => {
        const List = s.steps ? 'ol' : 'ul';
        return (
          <section class="section" aria-labelledby={`${data.slug}-${s.id}`}>
            <h2 id={`${data.slug}-${s.id}`}>{s.heading}</h2>
            <List class="points">
              {s.items.map((item) => (
                <li>{item}</li>
              ))}
            </List>
          </section>
        );
      })
    }
  </article>
</Tab>

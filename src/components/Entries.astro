---
// Groups of entries, as on Experience and Education: each group a section
// under its heading; each entry its title in bold, one muted line
// (organization, place, dates), a lead sentence, bullets, plain text links,
// at most one small photo and at most one button.
import { Picture, getImage } from 'astro:assets';
import Button from './Button.astro';
import { meta, type Group } from '../experience';

interface Props {
  groups: Group[];
}

// Certificates are linked as pictures, never shown on the page.
const sections = await Promise.all(
  Astro.props.groups.map(async (group) => ({
    ...group,
    entries: await Promise.all(
      group.entries.map(async (entry) => ({
        ...entry,
        certificateUrl:
          entry.certificate && (await getImage({ src: entry.certificate, format: 'webp', quality: 90 })).src,
      })),
    ),
  })),
);
---

{
  sections.map((group) => (
    <section class="section" aria-labelledby={group.id}>
      <h2 id={group.id}>{group.title}</h2>
      <ul class="entries">
        {group.entries.map((entry) => (
          <li class:list={['entry', { 'entry--photo': entry.photo }]} id={entry.id}>
            <div class="entry-text">
              <h3>{entry.title}</h3>
              {meta(entry) && <p class="entry-meta">{meta(entry)}</p>}
              {entry.lead && <p class="entry-lead">{entry.lead}</p>}
              {entry.points && (
                <ul class="points">
                  {entry.points.map((point) => (
                    <li>{point}</li>
                  ))}
                </ul>
              )}
              {(entry.links || entry.certificateUrl) && (
                <ul class="entry-links">
                  {entry.links?.map((link) => (
                    <li>
                      <a href={link.href}>{link.label}</a>
                    </li>
                  ))}
                  {entry.certificateUrl && (
                    <li>
                      <a href={entry.certificateUrl} aria-label={`View certificate (image): ${entry.title}`}>
                        View certificate (image)
                      </a>
                    </li>
                  )}
                </ul>
              )}
              {entry.button && (
                <ul class="actions">
                  <li>
                    <Button href={entry.button.href}>{entry.button.label}</Button>
                  </li>
                </ul>
              )}
            </div>
            {entry.photo && (
              <div class="entry-photo">
                <Picture
                  src={entry.photo.src}
                  alt={entry.photo.alt}
                  formats={['avif']}
                  fallbackFormat="webp"
                  widths={[320, 640]}
                  sizes="(min-width: 48em) 15rem, min(100vw, 20rem)"
                  loading="lazy"
                />
              </div>
            )}
          </li>
        ))}
      </ul>
    </section>
  ))
}

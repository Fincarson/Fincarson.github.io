---
import { site, sections, profileLinks, nthu, tabPath, NOT_FOUND } from '../site.config';
import '../styles/global.css';
import bodyFont from '../assets/fonts/atkinson-hyperlegible-next-400.woff2?url';
import titleFont from '../assets/fonts/big-shoulders-display-900.woff2?url';
import treeSymbols from '../assets/nthu/tree-symbols.svg?raw';

interface Props {
  /** Which site the page belongs to: its links, footer and colours. */
  variant?: 'main' | 'nthu';
  /** Every panel on the page: the query that opens it and its browser tab title. The first is the page's own. */
  panels: { id: string; title: string }[];
  description?: string;
  /** The 404 page: it has no address of its own, so no canonical link, and it stays out of search. */
  notFound?: boolean;
}

const { variant = 'main', panels, description = site.description, notFound = false } = Astro.props;
const isNthu = variant === 'nthu';
const base = isNthu ? nthu.base : '/';
const pageTitle = panels[0]!.title;
const nav = (isNthu ? nthu.sections : sections)
  .filter((s) => s.enabled)
  .map((s) => ({ label: s.label, tab: s.tab, href: tabPath(s.tab, base) }));
const footer = isNthu
  ? [
      { id: 'footer-pages', title: 'NTHU', links: [...nav, { label: "Author's page", href: '/' }] },
      { id: 'footer-links', title: 'Official links', links: nthu.officialLinks },
    ]
  : [
      { id: 'footer-pages', title: 'Pages', links: nav },
      { id: 'footer-socials', title: 'Socials', links: Object.values(profileLinks) },
    ];
const canonical = new URL(base, Astro.site);
const shareImage = new URL('/og.png', Astro.site);
const titles = Object.fromEntries(panels.map((p) => [p.id, p.title]));
// The 404 page sits at no address of its own: there the scripts show its one panel and switch nothing.
const home = notFound ? null : base;
---

<!doctype html>
<html lang="en" data-site={isNthu ? 'nthu' : undefined}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{pageTitle}</title>
    <meta name="description" content={description} />
    {notFound ? <meta name="robots" content="noindex" /> : <link rel="canonical" href={canonical} />}
    <!-- Before the first paint: marks that scripts run, applies the saved theme (the choice never
         leaves the browser), reads the address and shows only the panel it names. -->
    <script is:inline define:vars={{ titles, home, missing: NOT_FOUND }}>
      const root = document.documentElement;
      root.classList.add('js');
      try {
        if (localStorage.getItem('theme') === 'dark') root.dataset.theme = 'dark';
      } catch {}
      const head = document.head;
      const only = head.appendChild(document.createElement('style'));
      const canonical = head.querySelector('[rel=canonical]');
      const robots = head.appendChild(document.createElement('meta'));
      robots.name = 'robots';
      const address = canonical && canonical.href;
      // True for an address of this page, however it is spelled: /nthu, /nthu/, /nthu.html.
      const here = (path) => (path.replace(/(\/index)?(\.html)?\/?$/, '') || '/') === home;
      // Shows the panel the address names and returns its id.
      const show = () => {
        const query = new URLSearchParams(location.search);
        const tab = query.get('tab');
        const project = query.get('project');
        let id = tab ? 'tab=' + tab + (tab === 'projects' && project ? '&project=' + project : '') : '';
        if (!here(location.pathname) || !Object.hasOwn(titles, id)) id = missing;
        const found = id !== missing;
        only.textContent =
          `.tab:not([data-id="${id}"]){display:none}.tab[data-id="${id}"]{display:block}` +
          `.js nav [data-nav="${found ? tab || '' : id}"]{text-decoration:underline}`;
        document.title = titles[id];
        robots.content = found ? 'all' : 'noindex';
        if (canonical) {
          canonical.href = address + (id && found ? '?' + id : '');
          if (found) head.append(canonical);
          else canonical.remove();
        }
        return id;
      };
      show();
      window.tabs = { show, here, home, missing };
    </script>
    <link rel="icon" href="/favicon.ico" sizes="48x48" />
    <link rel="icon" href="/icon-512.png" type="image/png" sizes="512x512" />
    <link rel="apple-touch-icon" href="/apple-touch-icon.png" />
    <link rel="sitemap" href="/sitemap-index.xml" />
    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={site.name} />
    <meta property="og:title" content={pageTitle} />
    <meta property="og:description" content={description} />
    {!notFound && <meta property="og:url" content={canonical} />}
    <meta property="og:image" content={shareImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${site.name}, Personal Website`} />
    <meta name="twitter:card" content="summary_large_image" />
    <link rel="preload" href={bodyFont} as="font" type="font/woff2" crossorigin />
    <link rel="preload" href={titleFont} as="font" type="font/woff2" crossorigin />
  </head>
  <body>
    <a class="skip" href="#main">Skip to main content</a>
    <header class="site-header">
      <div class="wrap">
        <!-- Phones: opens the sidebar below. Shown by CSS once scripts run. -->
        <button class="tool menu-button" type="button" aria-label="Menu" aria-haspopup="dialog" aria-expanded="false">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
            <path d="M3 6h18M3 12h18M3 18h18"></path>
          </svg>
        </button>
        <nav aria-label="Main">
          <ul>
            {
              nav.map((s, i) => (
                <li>
                  <a href={s.href} data-nav={s.tab} aria-current={i === 0 && !notFound ? 'page' : undefined}>
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
        <div class="header-tools">
          <!-- Both controls are hidden until the script below runs: without JavaScript they could do nothing. -->
          <div class="lang" hidden>
            <button
              class="tool lang-button"
              type="button"
              aria-expanded="false"
              aria-controls="lang-menu"
              aria-label="EN, language: English"
            >
              <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true" focusable="false">
                <circle cx="12" cy="12" r="9.5"></circle>
                <path d="M2.5 12h19M12 2.5c3 3.2 3 15.8 0 19M12 2.5c-3 3.2-3 15.8 0 19"></path>
              </svg>
              <span aria-hidden="true">EN</span>
            </button>
            <!-- One entry per language; each links to the tab on show in that language (the script
                 keeps the address current). Where there is no such address, it links to Home. -->
            <ul class="lang-menu" id="lang-menu" hidden>
              <li>
                <a href={base} lang="en" hreflang="en" aria-current="true">
                  <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="3" aria-hidden="true" focusable="false">
                    <path d="M4 12.5l5 5L20 6.5"></path>
                  </svg>
                  English
                </a>
              </li>
            </ul>
          </div>
          <button class="tool theme-toggle" type="button" aria-pressed="false" aria-label="Dark mode" hidden>
            <svg class="icon-sun" viewBox="0 0 24 24" aria-hidden="true" focusable="false">
              <circle cx="12" cy="12" r="4.5" fill="currentColor"></circle>
              <path
                d="M12 1.5v3M12 19.5v3M1.5 12h3M19.5 12h3M4.6 4.6l2.1 2.1M17.3 17.3l2.1 2.1M4.6 19.4l2.1-2.1M17.3 6.7l2.1-2.1"
                fill="none"
                stroke="currentColor"
                stroke-width="2"></path>
            </svg>
            <svg class="icon-moon" viewBox="0 0 24 24" fill="currentColor" aria-hidden="true" focusable="false">
              <path d="M21 12.8A9 9 0 1 1 11.2 3a7 7 0 0 0 9.8 9.8z"></path>
            </svg>
          </button>
        </div>
      </div>
    </header>
    <!-- The phone sidebar: a modal dialog, so focus stays inside it and the page behind is inert. -->
    <dialog class="menu" id="menu" aria-label="Menu">
      <div class="menu-panel">
        <div class="menu-top">
          <button class="tool menu-close" type="button" aria-label="Close menu">
            <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.5" aria-hidden="true" focusable="false">
              <path d="M5 5l14 14M19 5L5 19"></path>
            </svg>
          </button>
        </div>
        <nav aria-label="Pages">
          <ul>
            {
              nav.map((s, i) => (
                <li>
                  <a href={s.href} data-nav={s.tab} aria-current={i === 0 && !notFound ? 'page' : undefined}>
                    {s.label}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </dialog>
    <main id="main" tabindex="-1">
      <!-- The shapes the sky art is drawn from, once per page; every panel's sky places them. -->
      <svg class="art-defs" width="0" height="0" aria-hidden="true" focusable="false">
        <symbol id="dove-a" viewBox="0 0 64 48">
          <path d="M61 24.5l-5.6-2.3c-1.3-3.2-5.2-4.4-8.1-2.6-1.3.8-2.6 1.3-4 1.4C45 14 48.5 6.5 54 1c-8.5 2.5-15.5 8.5-19.5 16.5C31 10.5 25 4.5 16 2c3.5 6.5 6 13.5 9.5 19.5C19.5 22 12 21 3 17.5l5 7-6 7c8.5 1 16.5.8 24-1 8.5 4.5 19 3.5 25.5-2.5 1.6-1.4 3.2-2.3 5-2.7z"></path>
        </symbol>
        <symbol id="dove-b" viewBox="0 0 64 48">
          <path d="M61 20.5l-5.6-2.3c-1.3-3.2-5.2-4.4-8.1-2.6-1.6 1-3.3 1.5-5.1 1.5C36.5 12.5 29 10 20 10.5c-6 .4-11.5 1.8-16.5 4.2 5.5.3 10.5 1.5 15 3.5-5 1.3-10.5 1.3-16.5-.2l5.5 6-5 7c8 .5 15.5-.2 22.5-2.2C28 37 33 43.5 40 46.5c-.5-6.5-.5-12.5 1.5-18 4-.8 7.5-2.5 10-4.8 1.6-1.4 3.2-2.3 5-2.7z"></path>
        </symbol>
        <symbol id="cloud-a" viewBox="0 0 240 90">
          <path d="M40 88a22 22 0 0 1-4-43.6A34 34 0 0 1 96 22a40 40 0 0 1 72 10 28 28 0 0 1 36 25.5A15.5 15.5 0 0 1 202 88z"></path>
        </symbol>
        <symbol id="cloud-b" viewBox="0 0 200 80">
          <path d="M30 78a18 18 0 0 1-1-36 30 30 0 0 1 54-18 36 36 0 0 1 66 14 20 20 0 0 1 0 40z"></path>
        </symbol>
        {isNthu && <Fragment set:html={treeSymbols} />}
      </svg>
      <slot />
    </main>
    <footer class="site-footer">
      <div class="wrap">
        <div class="footer-cols">
          {
            footer.map((column) => (
              <nav aria-labelledby={column.id}>
                <h2 id={column.id}>{column.title}</h2>
                <ul>
                  {column.links.map((l) => (
                    <li>
                      <a href={l.href}>{l.label}</a>
                    </li>
                  ))}
                </ul>
              </nav>
            ))
          }
        </div>
        <p>© {new Date().getFullYear()} {site.name}</p>
        <p>This site uses no cookies or tracking.</p>
      </div>
    </footer>
    <script is:inline>
      (() => {
        const root = document.documentElement;
        const tabs = window.tabs;

        // Theme toggle: pressed means dark. The choice stays in this browser.
        const toggle = document.querySelector('.theme-toggle');
        const isDark = () => root.dataset.theme === 'dark';
        toggle.hidden = false;
        toggle.setAttribute('aria-pressed', isDark());
        toggle.addEventListener('click', () => {
          const dark = !isDark();
          if (dark) root.dataset.theme = 'dark';
          else delete root.dataset.theme;
          try {
            localStorage.setItem('theme', dark ? 'dark' : 'light');
          } catch {}
          toggle.setAttribute('aria-pressed', dark);
        });

        // Language menu: the button opens it; Escape, a click elsewhere or focus leaving closes it.
        const lang = document.querySelector('.lang');
        const button = lang.querySelector('button');
        const menu = lang.querySelector('ul');
        const setOpen = (open) => {
          button.setAttribute('aria-expanded', open);
          menu.hidden = !open;
        };
        lang.hidden = false;
        button.addEventListener('click', () => setOpen(menu.hidden));
        lang.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && !menu.hidden) {
            setOpen(false);
            button.focus();
          }
        });
        lang.addEventListener('focusout', (e) => {
          if (!lang.contains(e.relatedTarget)) setOpen(false);
        });
        document.addEventListener('click', (e) => {
          if (!lang.contains(e.target)) setOpen(false);
        });

        // Phone menu: the dialog itself handles Escape, the focus trap and the return of focus.
        // A click on the dimmed area lands on the dialog element; the panel covers the rest.
        const sidebar = document.getElementById('menu');
        const opener = document.querySelector('.menu-button');
        opener.addEventListener('click', () => {
          sidebar.showModal();
          opener.setAttribute('aria-expanded', true);
        });
        sidebar.addEventListener('click', (e) => {
          if (e.target === sidebar || e.target.closest('.menu-close')) sidebar.close();
        });
        sidebar.addEventListener('close', () => opener.setAttribute('aria-expanded', false));

        // Tabs. The head script has already shown the panel the address names; this
        // brings the rest of the page in line with it: the current link, the
        // description and the share tags, and the language link.
        let panel;
        const meta = (name) => document.querySelector(`meta[${name}]`);
        const sync = () => {
          const id = tabs.show();
          const found = id !== tabs.missing;
          const current = found ? id.slice(4).split('&')[0] : id;
          panel = document.querySelector(`.tab[data-id="${id}"]`);
          for (const link of document.querySelectorAll('[data-nav]')) {
            if (link.dataset.nav === current) link.setAttribute('aria-current', 'page');
            else link.removeAttribute('aria-current');
          }
          meta('name=description').content = meta('property="og:description"').content = panel.dataset.description;
          meta('property="og:title"').content = document.title;
          if (tabs.home) {
            const address = tabs.home + (id && found ? '?' + id : '');
            menu.querySelector('a').href = address;
            meta('property="og:url"').content = location.origin + address;
          }
        };
        sync();
        // A plain click on a link to a tab of this page switches without a reload.
        // Anything else (a new browser tab, another page) is left to the browser.
        document.addEventListener('click', (e) => {
          const link = e.target.closest('a[href]');
          if (!link || e.defaultPrevented || e.button || e.metaKey || e.ctrlKey || e.shiftKey || e.altKey) return;
          if (link.target || link.hash || link.origin !== location.origin) return;
          if (!tabs.here(link.pathname) || !tabs.here(location.pathname)) return;
          e.preventDefault();
          if (link.href !== location.href) history.pushState(null, '', link.href);
          sync();
          setOpen(false);
          sidebar.close();
          scrollTo(0, 0);
          panel.querySelector('h1').focus({ preventScroll: true });
        });
        addEventListener('popstate', sync);

        // Shooting star: the first one 2 to 4 seconds after load, then one every 6 to 12
        // seconds, in the night sky only, at a new place in the fade below the text.
        // Never started when reduced motion is asked for: the streak then stays still.
        const still = matchMedia('(prefers-reduced-motion: reduce)');
        const wait = (min, span) => setTimeout(shoot, min + Math.random() * span);
        const shoot = () => {
          if (still.matches) return;
          if (isDark() && !document.hidden) {
            const star = panel.querySelector('.shooting');
            star.style.setProperty('--x', `${5 + Math.random() * 50}%`);
            star.style.setProperty('--y', `${8 + Math.random() * 22}%`);
            star.classList.remove('go');
            star.getBoundingClientRect();
            star.classList.add('go');
          }
          wait(6000, 6000);
        };
        if (!still.matches) wait(2000, 2000);
      })();
    </script>
  </body>
</html>
